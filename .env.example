# Service
DEBUG=true
LOG_LEVEL=INFO

# OpenDota
OPENDOTA_BASE_URL=https://api.opendota.com/api
OPENDOTA_TIMEOUT=30
OPENDOTA_RETRIES=3

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=dota2_analytics

# Discovery
DISCOVERY_LOBBY_TYPE=7
DISCOVERY_MIN_RANK_TIER=10
DISCOVERY_LIMIT=100
DISCOVERY_INTERVAL_SEC=300

# Auto rebuild
AUTO_REBUILD_AFTER_INGEST=true